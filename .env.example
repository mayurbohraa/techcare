# Coalition Patient Data API — use the username and password from the Postman documentation.
# https://documenter.getpostman.com/view/11861104/2sA35G42ve
#
# Authorization is sent as: Basic base64(username + ":" + password)

VITE_COALITION_USER=
VITE_COALITION_PASSWORD=

# These VITE_ values are included in the public browser bundle.
# Use assessment credentials only. Private credentials require a server-side proxy.
